# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit it.
# If you are initialising a new git repo, run:
#   git rm --cached .env
# to stop tracking it if it was already committed.

# Backend API base URL.
# Leave commented to use the CRA dev-proxy (proxy field in package.json).
# Set to your Railway/production URL for production builds.
# REACT_APP_API_URL=https://your-backend.up.railway.app/api
